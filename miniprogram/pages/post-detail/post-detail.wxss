page { background: #FFFBF0; }
.container { padding: 30rpx 24rpx 40rpx; }

.loading { text-align: center; padding: 120rpx 0; color: #999; font-size: 28rpx; }

/* 作者信息 */
.author-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.author-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #E8885A; color: #fff;
  font-size: 28rpx; text-align: center; line-height: 64rpx;
  flex-shrink: 0; margin-right: 16rpx;
}

.author-info { flex: 1; }

.author-name {
  font-size: 28rpx; font-weight: bold; color: #333;
  display: block;
}

.author-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 4rpx;
}

.post-category-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
  border: 1rpx solid;
}
.post-category-tag.cat-cat {
  background: #FFF0D6; color: #E8885A; border-color: #FFE0B2;
}
.post-category-tag.cat-volunteer {
  background: #E8F5E9; color: #388E3C; border-color: #A5D6A7;
}
.post-category-tag.cat-announce {
  background: #E3F2FD; color: #1565C0; border-color: #90CAF9;
}
.post-category-tag.cat-dev {
  background: #F3E5F5; color: #7B1FA2; border-color: #CE93D8;
}
.post-category-tag.cat-daily {
  background: #FFF8E1; color: #F57F17; border-color: #FFE082;
}

.post-date {
  font-size: 22rpx; color: #bbb;
  margin-top: 6rpx;
}

/* 财务公示 */
.finance-display {
  display: flex; gap: 16rpx; margin-top: 16rpx;
}
.finance-item {
  flex: 1; padding: 12rpx; border-radius: 10rpx;
  text-align: center; display: flex; flex-direction: column; gap: 4rpx;
}
.finance-item.income { background: #E8F5E9; }
.finance-item.expense { background: #FFEBEE; }
.finance-amount { font-size: 32rpx; font-weight: 700; }
.finance-item.income .finance-amount { color: #2E7D32; }
.finance-item.expense .finance-amount { color: #C62828; }
.finance-label-sm { font-size: 22rpx; color: #666; }

/* 称号标签（详情页） */
.post-role-row { display: flex; align-items: center; gap: 6rpx; margin-top: 4rpx; }
.post-role-badge {
  font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx;
  font-weight: 500; flex-shrink: 0;
}
.post-role-badge.role-rongdada {
  background: linear-gradient(135deg, #FFF8E1, #FFE082);
  color: #F57F17; border: 1rpx solid #FFB300;
}
.post-role-badge.role-developer {
  background: #E8F5E9; color: #388E3C; border: 1rpx solid #A5D6A7;
}
.post-title-badge {
  font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx;
  background: #f5f5f5; color: #888;
  border: 1rpx solid #ddd; font-weight: 500; flex-shrink: 0;
}

/* 标题 */
.detail-title {
  font-size: 36rpx; font-weight: bold; color: #333;
  display: block; margin-bottom: 20rpx; line-height: 1.4;
}

/* 内容 */
.detail-text {
  font-size: 30rpx; color: #555;
  line-height: 1.8; display: block;
  margin-bottom: 24rpx;
}

/* ===== 图片排版 ===== */
.image-section { margin-bottom: 24rpx; }

/* 1张图：居中，60%宽度，圆角 */
.img-1-wrap {
  text-align: center;
  background: #F0F0F0;
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.img-1 {
  width: 70%;
  max-height: 600rpx;
  border-radius: 12rpx;
}

/* 2张图：并排 */
.img-2-wrap {
  display: flex;
  gap: 10rpx;
}

.img-2 {
  flex: 1;
  height: 320rpx;
  border-radius: 14rpx;
}

/* 3张图：左大 + 右上/右下 */
.img-3-wrap {
  display: flex;
  gap: 10rpx;
}

.img-3-big {
  flex: 2;
  height: 400rpx;
  border-radius: 14rpx;
}

.img-3-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.img-3-small {
  width: 100%;
  height: 195rpx;
  border-radius: 14rpx;
}

/* 4张图：2x2网格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.img-grid-cell {
  width: calc(50% - 4rpx);
  height: 240rpx;
}

/* 5-9张图：3列九宫格 */
.img-grid-3 {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.img-grid-cell-3 {
  width: calc(33.33% - 4rpx);
  height: 220rpx;
}

/* 底部 */
.detail-footer {
  margin-top: 40rpx; padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.footer-label {
  font-size: 24rpx; color: #E8885A;
  display: block;
  margin-top: 20rpx;
}

/* 立即报名按钮 */
.volunteer-apply-row {
  margin-top: 24rpx;
  text-align: center;
}
.volunteer-apply-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #07C160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.volunteer-apply-btn::after { border: none; }

/* 删除按钮 */
.delete-row {
  margin-top: 40rpx;
  text-align: center;
}
.delete-btn {
  display: inline-block;
  background: none;
  border: 1rpx solid #ff4d4f;
  color: #ff4d4f;
  font-size: 26rpx;
  padding: 12rpx 40rpx;
  border-radius: 8rpx;
}

