/* ===== 启动动画页（完全重写）===== */
page {
  background: linear-gradient(160deg, #FFF6E5 0%, #FFECD2 50%, #FFE4C4 100%);
}

.splash-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* ===== 动画舞台 ===== */
.splash-stage {
  width: 550rpx;
  height: 260rpx;
  position: relative;
  display: flex;
  align-items: center;
}

/* ===== Logo ===== */
.logo-box {
  position: absolute;
  width: 270rpx;
  height: 270rpx;
  left: 165rpx;           /* (550-240)/2 → 居中 */
  top: 10rpx;              /* (260-240)/2 */
  opacity: 0;
  transform: scale(0);
  transition: left 0.8s cubic-bezier(0.34, 1.56, 0.64, 1),
              transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1),
              opacity 0.3s ease-out;
  z-index: 2;
}

/* Phase 1: 弹性出现（正中间） */
.logo-box.bounce {
  opacity: 1;
  transform: scale(1);
  left: 155rpx;
}

/* Phase 2: 平移到左 */
.logo-box.slide {
  opacity: 1;
  transform: scale(1);
  left: 0;
}

.logo-img {
  width: 100%;
  height: 100%;
}

.logo-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(232, 136, 90, 0.2);
}

.logo-emoji {
  font-size: 64rpx;
}

/* ===== 文字区域 ===== */
.text-box {
  margin-left: 268rpx;     /* 240rpx logo + 28rpx gap */
  opacity: 0;
  transition: opacity 0.6s ease-out;
}

.text-box.show {
  opacity: 1;
}

.name-row {
  display: flex;
  align-items: baseline;
}

.splash-name {
  font-size: 56rpx;
  font-weight: bold;
  color: #2C2C2C;
  letter-spacing: 6rpx;
  line-height: 1.2;
}

.cursor {
  display: inline-block;
  color: #E8885A;
  font-weight: 200;
  animation: blink 0.7s step-end infinite;
  margin-left: 2rpx;
  font-size: 48rpx;
}

.splash-subtitle {
  display: block;
  font-size: 24rpx;
  color: #c0b09a;
  letter-spacing: 2rpx;
  margin-top: 10rpx;
  opacity: 0;
  transform: translateY(8rpx);
  transition: all 0.7s ease-out;
}

.splash-subtitle.show {
  opacity: 1;
  transform: translateY(0);
}

/* ===== 版本号底部 ===== */
.version-tag {
  position: absolute;
  bottom: 80rpx;
  font-size: 22rpx;
  color: #d5c8b8;
  opacity: 0;
  transition: opacity 0.6s ease-out;
}

.version-tag.show {
  opacity: 1;
  color: #c0b09a;
}

/* ===== 关键帧 ===== */
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
