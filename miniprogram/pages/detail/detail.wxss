.container {
  padding: 30rpx 28rpx 40rpx;
}

/* 个人档案区 */
.profile {
  text-align: center;
  margin-bottom: 30rpx;
}

.avatar-wrap {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 16rpx;
  border: 6rpx solid #FFF0D6;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
}

.avatar-wrap image {
  width: 100%;
  height: 100%;
}

.name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.tags {
  margin-top: 14rpx;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  background: #FFF0D6;
  color: #C67B4E;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.info-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: #C67B4E;
  font-weight: bold;
  display: block;
  margin-bottom: 6rpx;
}

.value {
  font-size: 30rpx;
  color: #444;
  display: block;
  line-height: 1.6;
}

.healthy {
  color: #4CAF50;
}

.warn {
  color: #FF9800;
}

/* 提示卡片 */
.tip-card {
  background: #FFF8E8;
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #E8885A;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #C67B4E;
  display: block;
  margin-bottom: 10rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

/* 论坛相关帖子 */
.forum-section {
  margin-top: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.forum-post {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.forum-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.forum-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  display: block;
}

.forum-user {
  font-size: 22rpx;
  color: #bbb;
  display: block;
  margin-top: 8rpx;
}
