.container {
  padding: 30rpx 24rpx 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 50rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.search-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 分类标签 */
.status-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.status-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #999;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.status-tab.active {
  color: #E8885A;
  font-weight: bold;
  border: 2rpx solid #E8885A;
}

/* 猫咪列表（长条形卡片） */
.cat-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cat-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: transform 0.2s;
}

.cat-card:active {
  transform: scale(0.97);
}

.cat-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid #FFF0D6;
}

.cat-avatar image {
  width: 100%;
  height: 100%;
}

.cat-info {
  flex: 1;
  margin-left: 24rpx;
}

.cat-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.cat-brief {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.cat-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  display: block;
}

.empty-sub {
  font-size: 26rpx;
  color: #ccc;
  display: block;
  margin-top: 12rpx;
}
