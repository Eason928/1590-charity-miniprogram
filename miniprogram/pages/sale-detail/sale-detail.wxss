.container {
  padding-bottom: 60rpx;
}

/* ===== 加载中 ===== */
.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}

/* ===== 大图展示 ===== */
.image-wrap {
  width: 100%;
  height: 600rpx;
  overflow: hidden;
  background: #f8f4ec;
}

.main-image {
  width: 100%;
  height: 100%;
}

/* ===== 商品信息卡片 ===== */
.info-card {
  background: #fff;
  border-radius: 24rpx;
  margin: -30rpx 24rpx 20rpx;
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 2;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.product-price {
  font-size: 40rpx;
  color: #E8885A;
  font-weight: bold;
  white-space: nowrap;
}

/* ===== 类别标签 ===== */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tag {
  background: #FFF0D6;
  color: #C67B4E;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* ===== 分隔线 ===== */
.divider {
  height: 2rpx;
  background: #F5F0E8;
  margin: 16rpx 0;
}

/* ===== 商品描述 ===== */
.desc-section {
  margin-bottom: 16rpx;
}

.desc-label {
  font-size: 26rpx;
  color: #C67B4E;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  display: block;
}

.empty-desc {
  color: #ccc;
}

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #555;
}

/* ===== 底部说明卡片 ===== */
.notice-card {
  background: #FFF8E8;
  border-radius: 20rpx;
  margin: 0 24rpx 30rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border-left: 6rpx solid #E8885A;
}

.notice-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.notice-text-wrap {
  flex: 1;
}

.notice-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #C67B4E;
  display: block;
  margin-bottom: 6rpx;
}

.notice-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  display: block;
}

/* ===== 返回按钮 ===== */
.back-btn-wrap {
  margin: 0 24rpx;
}

.back-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #E8885A;
  font-size: 28rpx;
  border-radius: 44rpx;
  text-align: center;
  border: 2rpx solid #E8885A;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.back-btn::after {
  border: none;
}
