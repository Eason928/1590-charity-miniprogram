.container {
  padding-bottom: 40rpx;
  overflow-x: hidden;
}

/* ===== 轮播横幅 ===== */
.banner {
  width: 100%;
  height: 340rpx;
}

.banner-slide {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
}

.banner-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

/* ===== 分类筛选 ===== */
.category-scroll {
  white-space: nowrap;
  padding: 24rpx 24rpx 16rpx;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}

.category-item.active {
  background: #E8885A;
  color: #fff;
  font-weight: bold;
}

/* ===== 商品网格 ===== */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 18rpx 20rpx;
  gap: 16rpx;
  box-sizing: border-box;
  width: 100%;
}

.product-card {
  width: calc(50% - 18rpx);
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.product-image {
  width: 100%;
  height: 320rpx;
}

.product-info {
  padding: 16rpx 18rpx 20rpx;
  position: relative;
}

.product-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  font-size: 32rpx;
  color: #E8885A;
  font-weight: bold;
  display: block;
}

.product-category-tag {
  position: absolute;
  top: -8rpx;
  right: 12rpx;
  background: #FFF0D6;
  color: #C67B4E;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  display: block;
}

.empty-sub {
  font-size: 26rpx;
  color: #ccc;
  display: block;
  margin-top: 12rpx;
}

/* ===== 加载中 ===== */
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}
