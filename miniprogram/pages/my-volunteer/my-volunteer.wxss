page { background: #FFFBF0; }
.container { padding: 0 24rpx 40rpx; min-height: 100vh; }

/* 顶部 */
.top-header {
  text-align: center;
  padding: 36rpx 0 24rpx;
}
.top-icon { font-size: 64rpx; display: block; margin-bottom: 8rpx; }
.top-title {
  font-size: 36rpx; font-weight: bold; color: #C67B4E;
  display: block;
}

/* 登录提示 */
.login-prompt {
  text-align: center;
  padding: 120rpx 0;
}
.login-prompt-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.login-prompt-text { font-size: 28rpx; color: #999; display: block; margin-bottom: 24rpx; }

.login-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #E8885A; color: #fff;
  border-radius: 40rpx; font-size: 28rpx;
  border: none;
}
.login-btn::after { border: none; }

/* 加载 */
.loading { text-align: center; padding: 120rpx 0; }
.loading-text { font-size: 28rpx; color: #bbb; }

/* 报名卡片 */
.list { padding-bottom: 20rpx; }
.app-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.app-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.app-title {
  font-size: 30rpx; font-weight: bold; color: #333;
  flex: 1; margin-right: 12rpx; line-height: 1.4;
}

/* 状态标签 */
.status-tag {
  flex-shrink: 0;
  font-size: 22rpx; padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.status-tag.pending { background: #FFF8E1; color: #F57F17; }
.status-tag.confirmed { background: #E8F5E9; color: #388E3C; }
.status-tag.attended { background: #E3F2FD; color: #1565C0; }

/* 信息 */
.app-info {
  margin-bottom: 10rpx;
}
.app-time, .app-location {
  font-size: 26rpx; color: #666;
  display: block; margin-bottom: 6rpx;
}

/* 联系方式 */
.app-contact {
  background: #FFF5ED;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}
.contact-label { font-size: 24rpx; color: #999; flex-shrink: 0; }
.contact-value { font-size: 26rpx; color: #E8885A; }

/* 底部 */
.app-bottom { }
.app-date { font-size: 22rpx; color: #ccc; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
}
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 30rpx; color: #999; display: block; margin-bottom: 8rpx; }
.empty-hint { font-size: 26rpx; color: #ccc; display: block; margin-bottom: 28rpx; }

.go-btn {
  display: inline-block;
  padding: 18rpx 48rpx;
  background: #FFF5ED;
  color: #E8885A;
  border-radius: 40rpx; font-size: 28rpx;
  border: 2rpx solid #E8885A;
}
.go-btn::after { border: none; }
