/* ===== 图标系统 — 基于 SVG data URI (颜色继承自父元素的 color) ===== */
/* 来源：Feather Icons (MIT License) */

.icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  flex-shrink: 0;
}
.icon-sm { width: 32rpx; height: 32rpx; }
.icon-lg { width: 48rpx; height: 48rpx; }
.icon-xl { width: 64rpx; height: 64rpx; }

/* 颜色通过父元素的 color 控制 */
.icon-primary { color: var(--color-primary); }
.icon-accent  { color: var(--color-accent); }
.icon-success { color: var(--color-success); }
.icon-danger  { color: var(--color-danger); }
.icon-muted   { color: var(--text-hint); }
.icon-white   { color: #fff; }

